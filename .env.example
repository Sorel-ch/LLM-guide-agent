# 两个 Key 的实际存放位置是 E:/code/MCP-test/.env（mcp_test.py 启动时自动加载，
# 该文件已被 MCP-test/.gitignore 排除）。
# 本文件仅说明变量名，供换机器或改用环境变量注入时参考；不要把真实值写进仓库。

AMAP_API_KEY=你的高德Web服务Key
METASO_API_KEY=你的秘塔Key

# 可选
AMAP_HTTP_TIMEOUT=10
METASO_HTTP_TIMEOUT=30
METASO_SSE_READ_TIMEOUT=300
METASO_MCP_URL=https://metaso.cn/api/mcp
MCP_LOG_LEVEL=ERROR
