# 把本文件复制为仓库根 .env 并填入真实值（.env 已被 .gitignore 排除）。
# mcp/travel_mcp.py 与 scripts/raw_snapshot.py 启动时会自动加载仓库根 .env，
# 因此 .mcp.json 里不需要写 Key；也可以改用环境变量注入。变量名清单如下。

AMAP_API_KEY=你的高德Web服务Key
METASO_API_KEY=你的秘塔Key

# scripts/plan_agent.py 用的对话模型（OpenAI Compatible，值同你在 Cline 里填的那套）
LLM_BASE_URL=https://你的网关地址
LLM_API_KEY=你的模型Key
LLM_MODEL=deepseek-v4-flash-0731

# 可选
AMAP_HTTP_TIMEOUT=10
LLM_HTTP_TIMEOUT=90
METASO_HTTP_TIMEOUT=30
METASO_SSE_READ_TIMEOUT=300
METASO_MCP_URL=https://metaso.cn/api/mcp
MCP_LOG_LEVEL=ERROR
